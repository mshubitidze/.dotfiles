# Oxocarbon Delta themes, selected by the `delta-theme` wrapper.
# Palette: nyoom-engineering/base16-oxocarbon; dark diff roles follow oxocarbon.nvim.

[delta "oxocarbon-dark"]
	dark = true
	syntax-theme = Oxocarbon Dark
	blame-palette = "#161616 #262626 #393939 #1f1f1f #525252"
	commit-decoration-style = "#525252" bold box ul
	file-decoration-style = "#525252"
	file-style = "#f2f4f8"
	hunk-header-decoration-style = "#525252" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#78a9ff"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#525252"
	line-numbers-right-style = "#525252"
	line-numbers-zero-style = "#525252"
	line-numbers-minus-style = bold "#ee5396"
	line-numbers-plus-style = bold "#08bdba"
	minus-style = syntax "#361c28"
	minus-emph-style = bold syntax "#54273a"
	plus-style = syntax "#122f2f"
	plus-emph-style = bold syntax "#1b4848"
	map-styles = \
		bold purple => syntax "#352c48", \
		bold blue => syntax "#222a39", \
		bold cyan => syntax "#173b3b", \
		bold yellow => syntax "#44351f"

[delta "oxocarbon-light"]
	light = true
	syntax-theme = Oxocarbon Light
	blame-palette = "#ffffff #f3f3f3 #e8e8e8 #e0e0e0 #d5d5d5"
	commit-decoration-style = "#6f6f6f" bold box ul
	file-decoration-style = "#6f6f6f"
	file-style = "#37474f"
	hunk-header-decoration-style = "#6f6f6f" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#0f62fe"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6f6f6f"
	line-numbers-right-style = "#6f6f6f"
	line-numbers-zero-style = "#6f6f6f"
	line-numbers-minus-style = bold "#ee5396"
	line-numbers-plus-style = bold "#008f8c"
	minus-style = syntax "#fcddea"
	minus-emph-style = bold syntax "#f9c3da"
	plus-style = syntax "#cef2f1"
	plus-emph-style = bold syntax "#a9e8e7"
	map-styles = \
		bold purple => syntax "#f2eaff", \
		bold blue => syntax "#e4eeff", \
		bold cyan => syntax "#cef2f1", \
		bold yellow => syntax "#ffe2cc"
